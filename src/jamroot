path-constant qbk-media-root : ./share/fx-quickbook-media/qbk-media ;
path-constant cpphot-src-root : . ;
path-constant cpphot-web-root : ../docs ;

path-constant custom-files-dir : ./custom-files ;

#|
	Write exact filename under custom-files-dir here, do not use wild-match,
	as both cleanall and install will use them.
|#
constant
	custom-files
:

	# Add custom file here:

	404.html
	favicon.ico
	robots.txt
	sitemap.xml
;

#############################################################################
#############################################################################

argv = [ modules.peek : ARGV ] ;

if [ MATCH ^(clean)$ : $(argv) ]
{
	local cmd = "rm -rf $(cpphot-src-root)/bin $(cpphot-src-root)/html" ;
	echo "Rmove dirs =>\n   $(cmd)" ;
	SHELL $(cmd) ;

	exit ;
}

if [ MATCH ^(cleanall)$ : $(argv) ]
{
	{
	#### Remove dirs
		for dir in bin html
		{
			local path = $(cpphot-src-root)/$(dir) ;
			local cmd = "rm -rf $(path)" ;
			echo "Remove dir => $(cmd)" ;
			SHELL $(cmd) ;
		}
		local cmd = "rm -rf $(cpphot-web-root)/images" ;
		echo "Rmove dir => $(cmd)" ;
		SHELL $(cmd) ;
		echo ;
	}

	{
	#### Remove files
		local cmd = 
		"rm -rf `find $(cpphot-web-root) -iname '*.html' -o -iname '*.css' -o -iname '*.manifest'`"
		;
		echo "Remove files =>\n   $(cmd)" ;
		SHELL $(cmd) ;
		echo ;
	}

	{
	#### Remove custom files
		import path ;
		local dstfiles = "" ;
		for fn in $(custom-files)
		{
			local path = $(cpphot-web-root)/$(fn) ;
			if ! $(dstfiles)
			{
				dstfiles = "$(path)" ;
			}
			else
			{
				dstfiles = "$(dstfiles) $(path)" ;
			}
		}
		echo "\nRemove custom files =>" ;
		echo "   rm -rf $(dstfiles)\n" ;
		SHELL "rm -rf $(dstfiles)" ;
	}

	exit ;
}

xml xml-index : cpphot.qbk ;

boostbook
	html-index
:
	xml-index
:
	<xsl:param>"chunk.first.sections=1"
	<xsl:param>"chunker.output.doctype-public=-//W3C//DTD XHTML 1.0 Strict//EN"
	<xsl:param>"chunker.output.doctype-system=http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd"
	<dependency>media
;

install
	html
:
	[
		glob-tree-ex
			$(cpphot-src-root)/html
		:
			*.html
			*.manifest
	]
:
	<location>$(cpphot-web-root)
	<install-source-root>$(cpphot-src-root)/html
;

install
	custom-files
:
	[
		glob-tree-ex
			$(custom-files-dir)
		:
			$(custom-files)
	]
:
	<location>$(cpphot-web-root)
	<install-source-root>$(custom-files-dir)
;

install
	media
:
	[
		glob-tree-ex
			$(qbk-media-root)
		:
			*.css
			*.png
			*.svg
	]
:
	<location>$(cpphot-web-root)
	<install-source-root>$(qbk-media-root)
;

